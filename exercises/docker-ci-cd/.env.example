# Copy to .env and fill in. .env must never be committed.
#
# The application reads every one of these. There is no default for a credential, for
# the environment name, or for build provenance: missing configuration exits 64, and an
# untraceable build never reports itself ready.

# ---- database ------------------------------------------------------------
POSTGRES_DB=settlement
POSTGRES_USER=settlement
POSTGRES_PASSWORD=

# ---- what the application reads -----------------------------------------
# The JDBC URL points at the database service on the container network, not at localhost.
SETTLEMENT_DB_URL=
SETTLEMENT_DB_USER=
SETTLEMENT_DB_PASSWORD=
SETTLEMENT_DB_POOL_SIZE=8

SETTLEMENT_ENVIRONMENT=
SETTLEMENT_EXPECTED_SCHEMA_VERSION=3
SETTLEMENT_HTTP_PORT=8080
SETTLEMENT_MANAGEMENT_PORT=9090
SETTLEMENT_LOG_LEVEL=INFO

# Month-end reconciliation size. The acceptance suite drives 192 by default.
SETTLEMENT_REPORT_MB=192

# ---- build interface -----------------------------------------------------
# These are build arguments, not runtime settings. They are listed here so you can see
# the whole contract in one place: the image must carry them, and the running process
# must be able to report them back.
# BUILD_REVISION=<full git sha>
# BUILD_VERSION=<semver>
