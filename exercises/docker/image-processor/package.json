{
  "name": "@outage-lab/image-processor",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker that derives metadata for ingested assets.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "esbuild src/index.js src/healthcheck.js --bundle --platform=node --format=esm --packages=external --outdir=dist",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext js --exec node src/index.js",
    "healthcheck": "node dist/healthcheck.js"
  },
  "dependencies": {
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "nodemon": "^3.1.4"
  }
}
