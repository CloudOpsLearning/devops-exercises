# Copy to .env and fill in. .env must never be committed.
#
# Every variable below is read by the application code. There are no defaults for
# anything security relevant: a missing value exits 64, a well-known credential
# exits 65 when NODE_ENV=production.

# ---- runtime -------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# ---- identity ------------------------------------------------------------
# The uid/gid the long-lived services must actually run as. The application
# compares these against its own effective uid/gid and refuses to start on a
# mismatch. On Linux, `id -u` / `id -g` are relevant to how you answer this.
APP_UID=
APP_GID=

# ---- postgres ------------------------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=helios
POSTGRES_USER=helios
# Either POSTGRES_PASSWORD or POSTGRES_PASSWORD_FILE. Pick the one you can defend.
POSTGRES_PASSWORD=

# ---- redis ---------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- application ---------------------------------------------------------
QUEUE_NAME=helios-ingest
SCRATCH_DIR=/scratch
PROCESSED_SUBDIR=processed
EXPECTED_SCHEMA_VERSION=3
GATEWAY_PORT=8080

# ---- tuning knobs you are allowed to move --------------------------------
WORKER_CONCURRENCY=4
SPIKE_MB=320
SHUTDOWN_DRAIN_MS=750
MIGRATION_DELAY_MS=4000
